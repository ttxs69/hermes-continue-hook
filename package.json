{
  "name": "hermes-continue-hook",
  "version": "1.3.0",
  "description": "Stop the agent from asking permission for things it should just do — Claude Code, Codex, Qwen Code, Cursor, Copilot CLI, Gemini CLI, OpenCode, Pi, DeepSeek Harness, Hermes Agent.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli",
    "opencode",
    "deepseek-harness",
    "agent",
    "hooks",
    "automation",
    "stop-hook"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "continue-hook": "bin/continue-hook.js"
  },
  "files": [
    "bin/",
    "adapters/",
    "skills/",
    "hooks/",
    "detector.py",
    "hookctl.py",
    "agent-hooks/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "patch-mode/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests && node tests/test_opencode.mjs && node tests/test_installer.mjs && node tests/test_lifecycle.mjs",
    "test:dsh": "node tests/test_dsh.mjs",
    "test:coverage": "python3 -m pytest --cov --cov-report=term-missing",
    "lint": "ruff check . && ruff format --check . && npx eslint .",
    "typecheck": "mypy && npx tsc -p tsconfig.pi.json",
    "check": "./scripts/check.sh",
    "prepack": "node scripts/clean-pack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttxs69/hermes-continue-hook.git"
  },
  "homepage": "https://github.com/ttxs69/hermes-continue-hook",
  "bugs": {
    "url": "https://github.com/ttxs69/hermes-continue-hook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
