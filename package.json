{
  "name": "@ttxs69/hermes-continue-hook",
  "version": "1.3.4",
  "description": "Stop your coding agent from ending every turn with a question it could answer itself. Conditional continuation for Claude Code, Codex, Cursor, Copilot CLI, Gemini CLI, OpenCode and more.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli",
    "opencode",
    "deepseek-harness",
    "agent",
    "hooks",
    "automation",
    "stop-hook"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "continue-hook": "bin/continue-hook.js"
  },
  "files": [
    "bin/",
    "adapters/",
    "skills/",
    "hooks/",
    "detector.py",
    "hookctl.py",
    "agent-hooks/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "patch-mode/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "bash scripts/install-git-hooks.sh",
    "test": "python3 -m unittest discover -s tests && vitest run",
    "test:py": "python3 -m unittest discover -s tests",
    "test:js": "vitest run",
    "test:coverage": "python3 -m pytest --cov --cov-report=term-missing && vitest run --coverage",
    "lint": "ruff check . && ruff format --check . && eslint . && prettier --check '**/*.{js,mjs,ts,json,yml}'",
    "typecheck": "mypy && tsc -p tsconfig.json && tsc -p tsconfig.checkjs.json",
    "check": "./scripts/check.sh",
    "prepack": "node scripts/clean-pack.mjs",
    "prepublishOnly": "npm run check",
    "version": "node scripts/sync-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttxs69/hermes-continue-hook.git",
    "directory": "."
  },
  "homepage": "https://github.com/ttxs69/hermes-continue-hook",
  "bugs": {
    "url": "https://github.com/ttxs69/hermes-continue-hook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "author": "ttxs69"
}
