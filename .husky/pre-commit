#!/usr/bin/env sh
# pre-commit — the fast gate, on the files you are committing.
#
# Why a separate pre-push hook: the whole gate takes ~60 seconds (it runs the
# entire Python and JavaScript suites). That is fine before a push and not
# fine before every commit. This hook runs the checks that are cheap enough
# to run every time, and only on the files that changed.
#
# What this can and cannot catch: formatting and type errors. It cannot
# catch the failures that actually cost us a release — those were all
# "the local environment differs from CI's", which is what the pre-push hook
# and CI are for.
#
# Bypass once with: git commit --no-verify

set -e

cd "$(dirname "$0")/.."

# The toolchain must be the one the workflows use — same rule as
# the full gate does, and the reason it is checked here first: a commit made
# with the wrong node produces a different result than the same commit in CI.
# Compare the whole version, not the major. `.nvmrc` used to hold a major
# ("24"), and that was not the same thing: setup-node resolved it to 24.21.0
# while this machine ran 24.22.1, so "it runs here" still said nothing about
# "it runs there". A patch-level difference is the exact shape of the bug
# that cost six release attempts.
PINNED="$(tr -d '[:space:]' < .nvmrc 2>/dev/null)"
if [ -n "${PINNED}" ]; then
  CURRENT="$(node --version 2>/dev/null | sed 's/^v//')"
  if [ -n "${CURRENT}" ] && [ "${CURRENT}" != "${PINNED}" ]; then
    echo "node ${CURRENT} is running; .nvmrc pins ${PINNED}." >&2
    echo "Use that exact version (nvm use) so this check matches CI." >&2
    exit 1
  fi
fi

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

PY_FILES="$(echo "$STAGED" | grep '\.py$' || true)"
JS_FILES="$(echo "$STAGED" | grep -E '\.(js|mjs|ts|json|yml)$' || true)"

if [ -n "${PY_FILES}" ]; then
  echo "== ruff (staged python)"
  # shellcheck disable=SC2086
  ruff check $PY_FILES
  # shellcheck disable=SC2086
  ruff format --check $PY_FILES
fi

if [ -n "${JS_FILES}" ]; then
  echo "== prettier (staged javascript)"
  # shellcheck disable=SC2086
  npx --no-install prettier --check $JS_FILES
fi

echo "== mypy"
mypy

exit 0
